  "palette": ["#07111c", "#12313a", "#65f3bc", "#285a65", "#b17b51"],
  "presentation": {"procedural": false},
  "map": {
    "width": 1200,
    "height": 1000,
    "layout": "maze",
    "start": {"x": 70, "y": 252},
